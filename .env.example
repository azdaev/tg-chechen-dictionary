DB_PATH=/app/data/database.db
REDIS_ADDR=redis:6379
TG_BOT_TOKEN=your_bot_token_here
TG_ADMIN_ID=your_admin_id_here
DONATION_LINK=your_donation_link_here

# Rich messages (Bot API 10.1) - Optional
# 1 sends translation cards as sendRichMessage: headings, sense lists, a
# two-column example table and the examples the plain card has to drop.
# Anything else keeps the plain HTML card. A failed rich send falls back on
# its own, so this is safe to flip and flip back.
RICH_MESSAGES=

# Dictionary API (dosham.app) - Optional
# Defaults to https://api.dosham.app/gql if not set
DOSHAM_API_URL=

# AI Formatting (OpenRouter) - Optional
# If not set, AI formatting will be disabled
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview